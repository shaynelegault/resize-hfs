--- !tapi-tbd
tbd-version:     4
targets:         [ armv7-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - targets:         [ armv7-ios ]
    symbols:         [ dyld_stub_binder, ___stack_chk_fail, ___stack_chk_guard, ___error, _lstat, _sysctlbyname, _memset, _strcmp, _printf, _puts ]
...
